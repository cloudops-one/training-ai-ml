# Copy this file to .env (same folder) and fill in ONE provider.
# .env is git-ignored. Never commit an API key.
# Details and the model-for-your-memory table: setup/README.md

# Which LLM the Module 09 notebooks use:
#   ollama | anthropic | openai | gemini | groq | lmstudio
LLM_PROVIDER=ollama

# Optional: a model other than the provider's default.
# It belongs to the provider above: change or remove it when you switch provider.
#   Ollama by memory:  8 GB -> llama3.2 (default)   16 GB -> qwen2.5:7b
# LLM_MODEL=qwen2.5:7b

# Optional: Ollama context window in tokens (default 8192). Bigger uses more memory.
# LLM_CONTEXT=8192

# Keys: only the one for your provider is needed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
